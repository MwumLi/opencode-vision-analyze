  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "vision",
    "vision-model",
    "image",
    "multimodal",
    "plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MwumLi/opencode-vision-analyze.git"
  },
  "homepage": "https://github.com/MwumLi/opencode-vision-analyze#readme",
