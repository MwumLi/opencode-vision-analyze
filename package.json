  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.16.2",
    "@opencode-ai/sdk": "^1.16.2",
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2"
  }
